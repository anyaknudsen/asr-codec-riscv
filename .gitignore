# Generated binaries (native + RISC-V), never hand-edited.
/build/*
!/build/.gitkeep

# Run outputs/logs/stats - regenerated by scripts/run_*.sh, not source.
/results/native/*
!/results/native/.gitkeep
/results/spike/*
!/results/spike/.gitkeep
/results/gem5/*
!/results/gem5/.gitkeep

# Editor/OS noise.
*.swp
.DS_Store
